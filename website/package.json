{
  "name": "raft-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "python3 -m http.server 4300 --bind 127.0.0.1 --directory .preview",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "test": "node --test scripts/search-results.test.mjs && node scripts/verify-site.mjs",
    "postbuild": "node scripts/prepare-assets.mjs --preview",
    "test:e2e": "node e2e-runner.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.16.2",
    "lucide-react": "^1.50.0",
    "next": "16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.2",
    "@oxlint/plugins": "1.87.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "e2e": "0.21.2",
    "oxlint": "1.87.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module"
}
